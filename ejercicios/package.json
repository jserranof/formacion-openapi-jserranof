{
	"name": "ejercicios",
	"version": "1.0.0",
	"description": "Ejercicios del curso con pruebas automáticas",
	"private": true,
	"type": "module",
	"scripts": {
		"comprobar": "tsx comprobar.ts",
		"dev:s01": "tsx watch s01/src/server.ts",
		"typecheck": "tsc --noEmit",
		"dev:s02": "tsx watch s02/src/server.ts",
		"dev:s03": "tsx watch s03/src/server.ts",
		"tipos:s03": "openapi-typescript s03/openapi.yaml -o s03/src/tipos/api.d.ts",
		"lint:s03": "tsx lint.ts s03",
		"pruebas:s03": "vitest run --config s03/pruebas/mutantes/vitest.config.ts",
		"dev:s04": "tsx watch s04/src/server.ts",
		"tipos:s04": "openapi-typescript s04/openapi.yaml -o s04/src/tipos/api.d.ts",
		"mcp:s04": "tsx s04/src/servidor-mcp.ts",
		"autorizacion": "npm --prefix ../docs/ejemplos/oauth-demo run autorizacion"
	},
	"engines": {
		"node": ">=22.12"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"cors": "^2.8.6",
		"express": "^5.3.0",
		"express-openapi-validator": "^5.6.2",
		"express-rate-limit": "^8.7.3",
		"helmet": "^8.3.0",
		"jose": "^6.2.15",
		"swagger-ui-express": "^5.0.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@redocly/openapi-core": "^1.34.23",
		"@seriousme/openapi-schema-validator": "^2.11.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.5",
		"@types/supertest": "^7.2.1",
		"@types/swagger-ui-express": "^4.1.8",
		"ajv": "^8.20.0",
		"oauth2-mock-server": "^9.3.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	}
}
