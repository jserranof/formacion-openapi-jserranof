{
	"name": "api-base",
	"version": "1.0.0",
	"description": "Plantilla de API REST en Node y TypeScript para el curso de OpenAPI",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "node dist/server.js",
		"build": "tsc",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22.12"
	},
	"dependencies": {
		"express": "^5.3.0",
		"swagger-ui-express": "^5.0.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.5",
		"@types/swagger-ui-express": "^4.1.8",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
